      ],
      "dependencies": [],
      "context_digest": "sha256:2d5b51397c7ce0422cc5943d9258caedd0e51fcee000d238e8bbbd52180833e0",
      "review": null
    },
    {
      "logical_id": "E2EESA-R-00020",
      "requirement_id": "REQ-e68beea9d173f5e81f33f61fabcb45252db54890cf8027ec863ad6840ec046be",
      "document_path": "spec/push-provider-privacy.md",
      "text_digest": "sha256:ed8cdbfd3f9333376a4828e7c25cb02e36e08381ccbc5fcdcc7c745f7cbd8244",
      "author_id": "galinsky-labs-ai-assisted",
      "rationale": "A response-delay or batching policy is meaningful only if final dispatch actually enforces it. A digest of a correlation study does not establish a concrete anonymity set, so privacy claims must be limited to the studied observer, service conditions and empirical evidence rather than inferred from policy labels.",
      "threat_ids": [
        "TM-METADATA",
        "TM-NET-PASSIVE"
      ],
      "security_property_ids": [
        "SP-METADATA-MINIMIZATION",
        "SP-UNLINKABILITY"
      ],
