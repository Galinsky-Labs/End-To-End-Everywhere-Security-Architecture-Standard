      "review": null
    },
    {
      "logical_id": "E2EESA-R-00021",
      "requirement_id": "REQ-160c25bf9f21a6cad6862158c9777ac10e2e4cfad7ff5a62d9e7c72efee6640f",
      "document_path": "spec/push-provider-privacy.md",
      "text_digest": "sha256:bf28fe49d209ecfa1f3b5fd46dd768b25b420994919422ef7ec299bf2ecd314c",
      "author_id": "galinsky-labs-ai-assisted",
      "rationale": "Reference policy checking is valuable for rejecting malformed push declarations but cannot establish what bytes a real provider receives or whether the provider holds the decryption key. Product-level privacy therefore needs network captures, endpoint instrumentation and key-control evidence across retries, crashes and notification extensions.",
      "threat_ids": [
        "TM-SERVICE-READ",
        "TM-METADATA"
      ],
