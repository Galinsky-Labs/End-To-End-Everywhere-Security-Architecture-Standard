        "captured-egress-outer-field-validation"
      ],
      "external_standard_ids": [
        "NIST-SP800-53R5"
      ],
      "dependencies": [],
      "context_digest": "sha256:4285bd90440d2822e474c576fc0f63863625fbded1434fd7f5775ee5afd656fa",
      "review": null
    },
    {
      "logical_id": "E2EESA-R-00019",
      "requirement_id": "REQ-5ccd0d2c22c38bf665be027e44a543f1f1c84b6247c11c188bca560726ddda28",
      "document_path": "spec/push-provider-privacy.md",
      "text_digest": "sha256:9601804b34db2900881748347b0226379634ee433accbf363024840a7ff3adfa",
      "author_id": "galinsky-labs-ai-assisted",
      "rationale": "A reused routing token or highly correlated notification timing can join otherwise separate application identities. Scoped identifiers and source-bound observation reporting reduce unnecessary linkage, while avoiding unsupported anonymity guarantees against observers that can correlate global traffic patterns.",
      "threat_ids": [
        "TM-METADATA",
        "TM-NET-PASSIVE"
      ],
      "security_property_ids": [
        "SP-UNLINKABILITY",
        "SP-METADATA-CONFIDENTIALITY"
